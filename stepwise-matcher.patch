@@ -558,15 +558,26 @@ bool type_checker::match_rewrite_pattern(expr const & p, expr const & e, rewrite
         expr const & fn = get_app_fn(t);
         return is_constant(fn) && const_name(fn) == const_name(p_fn) && get_app_num_args(t) == nargs;
     };
+    /* Unfold `e` one step at a time, checking the head after each step: unfolding all the way to
+       weak head normal form can turn an application of a projection function such as
+       `CategoryStruct.id` into a primitive projection. */
     expr t = e;
     while (is_mdata(t))
         t = mdata_expr(t);
-    if (!is_match(t)) {
-        t = whnf(t);
-        if (is_nat_lit(t))
-            t = nat_lit_to_constructor(t);
-        if (!is_match(t))
-            return false;
+    while (!is_match(t)) {
+        t = whnf_core(t);
+        if (is_match(t))
+            break;
+        if (optional<expr> r = reduce_nat(t)) {
+            t = *r;
+        } else if (optional<expr> u = unfold_definition(t)) {
+            t = *u;
+        } else {
+            if (is_nat_lit(t))
+                t = nat_lit_to_constructor(t);
+            if (!is_match(t))
+                return false;
+        }
     }
     levels const & p_ls = const_levels(p_fn);
     levels const & t_ls = const_levels(get_app_fn(t));
