+set_option compiler.ignoreBorrowAnnotation true in
+/-- Forward reference to `whnfUntil`. -/
+@[extern "lean_whnf_until"]
+private opaque whnfUntilFwd : Expr → Name → MetaM (Option Expr)
+
 /--
 Returns the arguments of `e` if it is an application of `c` to `n` arguments, possibly after
-putting it in weak head normal form.
+unfolding it. The head is checked after each unfolding step, since unfolding all the way to weak head
+normal form can turn an application of a projection function such as `CategoryStruct.id` into a
+primitive projection.
 -/
 private def matchRewriteHead? (e : Expr) (c : Name) (n : Nat) : MetaM (Option (List Level × Array Expr)) := do
   let e := e.consumeMData
   if e.isAppOfArity c n then
     return some (e.getAppFn.constLevels!, e.getAppArgs)
-  let e ← (← whnf e).toCtorIfLit
+  let e ← match (← whnfUntilFwd e c) with
+    | some e => pure e
+    | none => (← whnf e).toCtorIfLit
   if e.isAppOfArity c n then
     return some (e.getAppFn.constLevels!, e.getAppArgs)
   return none
@@ -1043,6 +1052,11 @@ def whnfUntil (e : Expr) (declName : Name) : MetaM (Option Expr) := do
   else
     return none
 
+set_option compiler.ignoreBorrowAnnotation true in
+@[export lean_whnf_until]
+private def whnfUntilImp (e : Expr) (declName : Name) : MetaM (Option Expr) :=
+  whnfUntil e declName
+
 /-- Applies `whnfCore` while unfolding type annotations (`outParam`/`optParam`/etc.). -/
 partial def whnfCoreUnfoldingAnnotations (e : Expr) : MetaM Expr :=
   whnfHeadPred e (fun e => return e.isTypeAnnotation)
diff --git a/src/kernel/type_checker.cpp b/src/kernel/type_checker.cpp
